{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "dev": "npx pnpm --filter \"@workspace/*\" --parallel dev",
    "dev:frontend": "npx pnpm --filter @workspace/hostel-outpass dev",
    "dev:php": "php -S localhost:5000 artifacts/php-server/index.php",
    "db:push": "npx pnpm --filter @workspace/db push",
    "build": "npx pnpm run typecheck && npx pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npx pnpm run typecheck:libs && npx pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
